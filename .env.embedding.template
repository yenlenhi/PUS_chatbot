# ============================================
# EMBEDDING CONFIGURATION
# ============================================

# Choose your embedding model based on your needs:

# Option 1: 384 dimensions (Faster, less memory, RECOMMENDED for Railway Starter)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Option 2: 768 dimensions (Better accuracy, more memory)
# EMBEDDING_MODEL=bkai-foundation-models/vietnamese-embedding-v1
# EMBEDDING_DIMENSION=768

# Option 3: 768 dimensions (Excellent multilingual model)
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_DIMENSION=768

# Option 4: Fallback English model (384 dimensions, fastest)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# ⚠️ DEPRECATED - DO NOT USE (Model unavailable on Hugging Face):
# EMBEDDING_MODEL=keepitreal/vietnamese-sbert
# EMBEDDING_MODEL=hiieu/halong_embedding

# ============================================
# RAILWAY DEPLOYMENT QUICK REFERENCE
# ============================================

# For Railway Starter Plan (512MB RAM):
# - Use 384-dimensional models (Option 1 or 4) 
# - Set: EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# - Set: EMBEDDING_DIMENSION=384

# For Railway Developer Plan (8GB RAM+):
# - Can use 768-dimensional models (Option 2 or 3)
# - Set: EMBEDDING_MODEL=bkai-foundation-models/vietnamese-embedding-v1
# - Set: EMBEDDING_DIMENSION=768

# ============================================
# IMPORTANT NOTES
# ============================================

# 1. EMBEDDING_DIMENSION must match your chosen model:
#    - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 → 384
#    - bkai-foundation-models/vietnamese-embedding-v1 → 768
#    - intfloat/multilingual-e5-base → 768
#    - all-MiniLM-L6-v2 → 384

# 2. If you change EMBEDDING_DIMENSION, you MUST:
#    - Drop and recreate the embeddings table
#    - Rebuild all embeddings
#    - See VECTOR_DIMENSION_FIX.md for detailed instructions

# 3. To fix dimension mismatch errors:
#    - Run: python scripts/check_vector_dimension.py (diagnose)
#    - Run: python scripts/fix_vector_dimension.py (fix)
#    - Rebuild: python scripts/build_embeddings.py

